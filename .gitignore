# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Portable SDK, local configuration, and build logs
/.flutter-sdk/
/build.log
/channels_config.json

# Local zip packages and binaries
/*.zip
.write_test

# The entire bundled runtime (streamlink, embedded CPython, its site-packages,
# ffmpeg/ffprobe, yt-dlp, AtomicParsley) is deliberately NOT committed. It is
# fetched and hash-verified from the versions pinned in bin/deps_manifest.json
# by tools/fetch-deps.ps1, which the release workflow, CI and build.ps1 all run.
# Do not "fix" a missing binary by committing it - update the manifest instead.
*.exe
/bin/Python/
/bin/pkgs/
/bin/bin/
/bin/ffmpeg/
/bin/LICENSE.txt
/bin/FFMPEG-LICENSE.txt

# Download cache and packaging staging area used by tools/fetch-deps.ps1
# and the release workflow.
/.deps-cache/
/dist/

# Environment / Secret configs
.env
.env.*


# Screenshot review artifacts: large, regenerable, and they can contain
# real channel names and avatars from the captured session.
shots/

# Scratch files written by audit subagents; never part of the suite.
test/zz*_test.dart
test/tmp_*_test.dart
test/zzz*_test.dart
