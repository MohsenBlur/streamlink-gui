// Version and icon resources for updater.exe.
//
// Without these the helper shipped as a bare binary: Windows showed it as
// "updater.exe" from an unknown program in the UAC consent dialog, with no
// product name, description or version to identify it.

#include "resource.h"
#include <windows.h>

IDI_APP_ICON            ICON                    "..\\resources\\app_icon.ico"

#ifdef FLUTTER_VERSION_MAJOR
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_NUMBER 1,0,0,0
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Twitch Streamlink GUI" "\0"
            VALUE "FileDescription", "Twitch Streamlink GUI Updater" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "updater" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Twitch Streamlink GUI. All rights reserved." "\0"
            VALUE "OriginalFilename", "updater.exe" "\0"
            VALUE "ProductName", "Twitch Streamlink GUI" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
